[Unit]
Description=IRIS MailGuard API (FastAPI + Gunicorn)
After=network.target docker.service
Requires=network.target

# --max-requests 500 / --max-requests-jitter 50: fiecare worker se recicleaza dupa ~500 de
# cereri (jitter ca sa nu plece toti odata), deci RSS-ul acumulat se intoarce la OS. E o plasa
# de siguranta, NU un fix: dupa cele 4 OOM-uri din aug-sept 2026 cauza reala a fost sync-ul DV
# care tinea tot view-ul in memorie (reparat prin streaming per pagina in app/api/v1/iris_dv.py).
# Reciclarea e gratioasa — un worker isi termina cererile in curs inainte sa fie inlocuit.
#
# ATENTIE: unitatile systemd NU se propaga prin `git pull` (vezi DEPLOY.md). Dupa deploy:
#   sudo cp /opt/iris-mailguard/systemd/mailguard-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart mailguard-api
[Service]
Type=notify
User=root
WorkingDirectory=/opt/iris-mailguard
EnvironmentFile=/opt/iris-mailguard/.env
ExecStart=/opt/iris-mailguard/venv/bin/gunicorn \
    -k uvicorn.workers.UvicornWorker \
    -w 4 \
    -b 127.0.0.1:8500 \
    --timeout 60 \
    --max-requests 500 \
    --max-requests-jitter 50 \
    --access-logfile /opt/iris-mailguard/logs/access.log \
    --error-logfile /opt/iris-mailguard/logs/error.log \
    app.main:app
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
