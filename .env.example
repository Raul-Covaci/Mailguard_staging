# .env.example — sablon de configurare MailGuard / Cargo360
#
# Copiaza in .env si completeaza valorile pentru mediul tau:
#   cp .env.example .env && chmod 600 .env
#
# .env NU intra in Git (vezi .gitignore). Valorile reale se iau de pe server:
#   scp mailguard-staging:/opt/iris-mailguard/.env .env
#
# Doua locatii sint citite de aplicatie: ./.env (principal, prin pydantic
# BaseSettings) si ./app/.env. Pe server, systemd incarca ./.env prin
# EnvironmentFile (vezi systemd/mailguard-api.service).

# ---------------------------------------------------------------------------
# APLICATIE
# ---------------------------------------------------------------------------
APP_ENV=production          # production | staging
APP_PORT=8500               # gunicorn asculta aici; nginx face proxy pe 8501
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# BAZA DE DATE (PostgreSQL) — pe staging ruleaza in containerul mailguard-db
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5440
DB_NAME=mailguard
DB_USER=mailguard
DB_PASSWORD=

# ---------------------------------------------------------------------------
# REDIS
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2                  # separat de parser-email-op (db 0)

# ---------------------------------------------------------------------------
# AUTENTIFICARE
# ---------------------------------------------------------------------------
JWT_SECRET=                 # generat: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Login prin IRIS SSO (login cu parola e dezactivat — HTTP 410).
# Secretul e partajat cu IRIS; fara el nu se poate autentifica nimeni.
IRIS_SSO_SECRET=

# ---------------------------------------------------------------------------
# MICROSOFT 365 (citire cutii postale)
# ---------------------------------------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_USER_EMAIL=
MS_AUTH_MODE=
O365_PAGE_LIMIT=

# Cheie de criptare pentru credentialele cutiilor personale (in DB).
# Daca o schimbi, credentialele existente devin necitibile.
PERSONAL_MAILBOX_KEY=

# ---------------------------------------------------------------------------
# IRIS / LLM
# ---------------------------------------------------------------------------
IRIS_API_URL=https://iris.cargotrack.ro
IRIS_API_KEY=
IRIS_AI_URL=
IRIS_AI_KEY=
IRIS_LLM_KEY=
IRIS_LLM_MODEL=
IRIS_TRANSCRIBE_URL=
IRIS_TRANSCRIBE_KEY=
IRIS_MAILGUARD_API_KEY=

# ---------------------------------------------------------------------------
# CTS / Cargo360 (sincronizare clasificari + ground truth)
# ---------------------------------------------------------------------------
CTS_ADMIN_API_KEY=
CTS_FEED_API_KEY=
CTS_SEND_CLASSIFICATION=false   # pe staging: true doar pentru test, NU afecteaza CTS live
CTS_GT_DSN=
CTS_GT_URL=
CTS_GT_TOKEN=
CTS_GT_QUERY=

# ---------------------------------------------------------------------------
# COMUTATOARE AI — pune AI_DISABLED=true daca nu ai chei (aplicatia porneste,
# doar functiile AI lipsesc).
# ---------------------------------------------------------------------------
AI_DISABLED=false
AI_CATEGORIZE_ENABLED=true
AI_DEPARTMENT_ENABLED=true
AI_PRIORITY_ENABLED=true
AI_ASSIGNEE_ENABLED=true
AI_AUTOREPLY_ENABLED=false
AI_CASCADE_ENABLED=true
AI_CASCADE_THRESHOLD=
AI_PRIORITY_THRESHOLD=
ANALYZE_FULL_THREAD=
INTENT_CLASSIFY_ENABLED=
STRICT_INTENT_GATE_ENABLED=

# Autoreply: pe staging NU trimite catre clienti reali.
AUTOREPLY_AUTOSEND_ENABLED=false
AUTOREPLY_SEND_MODE=
NOREPLY_BASE_URL=

# ---------------------------------------------------------------------------
# ANTIVIRUS / SCANARE ATASAMENTE
# ---------------------------------------------------------------------------
CLAMD_SOCKET=/var/run/clamav/clamd.ctl
MG_SCAN_MAX_BYTES=

# ---------------------------------------------------------------------------
# CAI / PREFIXE
# ---------------------------------------------------------------------------
ATTACH_HOST_PREFIX=
CALL_AUDIO_HOST_PREFIX=
IRIS_SPAM_WHITELIST_PATH=
# MAILGUARD_ENV: production | staging (gol = se cade pe APP_ENV). Controleaza garzile de
# trimitere reala: feedback catre clienti si redirectul VATHUB. Setat pe "staging" opreste
# trimiterea chiar si pe o masina de productie.
MAILGUARD_ENV=
MAILGUARD_NATIVE_INGEST=

# Redirect VATHUB: trimite DOAR din productie (staging si productia citesc aceeasi casuta,
# deci ambele ar forwarda -> duplicate in VATHUB). Pornit "on", permite trimiterea de test pe
# staging NUMAI catre raul.covaci@cargotrack.ro / raul.covaci@trakosoft.ro. Implicit oprit.
MAILGUARD_VATHUB_ALLOW_STAGING=

# ---------------------------------------------------------------------------
# WHILE1 (integrare telefonie)
# ---------------------------------------------------------------------------
# WHILE1_API_URL / WHILE1_API_URL_ALT: cele DOUA baze incercate, in ordine. While1 muta API-ul pe
# host multi-tenant fara data de cutover anuntata, deci codul le sondeaza pe amandoua si o retine pe
# cea care raspunde (settings `while1_api_base`; vezi GET /api/v1/calls/while1-status).
# Lasate goale => defaults din cod: https://cargo.while1.biz si https://voice.while1.biz/tenant/cargo.
# Sufixul '/api' se taie automat, deci se poate lipi URL-ul exact cum vine din emailul While1.
WHILE1_API_URL=
WHILE1_API_URL_ALT=
WHILE1_API_KEY=
WHILE1_API_TOKEN=

# ---------------------------------------------------------------------------
# NOVA (legacy)
# ---------------------------------------------------------------------------
NOVA_LLM_URL=
NOVA_LLM_KEY=
NOVA_MAILGUARD_API_KEY=
